{
  "title": "MyStartUp HRM Service",
  "uid": "mystartup-hrm",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "HRM Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"hrm-service\"}" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"hrm-service\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
