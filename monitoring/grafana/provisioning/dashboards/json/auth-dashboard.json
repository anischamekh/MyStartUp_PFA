{
  "title": "MyStartUp Authentication",
  "uid": "mystartup-auth",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Auth Service Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"auth-service\"}", "legendFormat": "up" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate (auth)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"auth-service\"}[5m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Memory (auth)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"auth-service\"}) by (area)",
          "legendFormat": "{{area}}"
        }
      ]
    }
  ]
}
