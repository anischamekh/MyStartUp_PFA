{
  "title": "MyStartUp Authentication",
  "panels": [
    {
      "type": "stat",
      "title": "Auth Service Health",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{application=\"auth-service\"}" }]
    },
    {
      "type": "timeseries",
      "title": "Login HTTP Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(http_server_requests_seconds_count{application=\"auth-service\",uri=~\".*/auth/login.*\"}[5m])" }]
    }
  ],
  "schemaVersion": 39
}
