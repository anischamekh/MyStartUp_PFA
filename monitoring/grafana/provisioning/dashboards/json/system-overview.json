      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)" }]
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes) by (application)" }]
    }
  ],
  "schemaVersion": 39
}
